# ============================================================================
# revans-hp 環境変数サンプル
# 実際の値は .env.local（gitignore 済み）や Vercel の環境変数に設定する。
# このファイルには「変数名」だけを載せる。値は絶対にコミットしない。
# ============================================================================

# ── Supabase（ブログ表示・問い合わせ保存の共通） ──
# 公開サイトの読み取り用（ブラウザに露出してよい匿名キー）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# サーバー専用。RLS をバイパスする service_role キー（NEXT_PUBLIC_ を付けない）。
# ブログ記事の保存と、お問い合わせの保存に使う。未設定だと問い合わせ保存が失敗する。
SUPABASE_SERVICE_ROLE_KEY=

# ── お問い合わせ通知メール（Resend） ──
# 未設定でもビルド/送信処理は壊れない（メール送信をスキップし mail_error に記録、
# 問い合わせ自体は Supabase に保存される）。
RESEND_API_KEY=
# 通知メールの宛先（自社の受信箱）
CONTACT_NOTIFY_EMAIL=
# 通知メールの差出人（Resend で認証済みドメインのアドレス）
CONTACT_FROM_EMAIL=

# ── AIブログ生成（サーバー専用） ──
# Cron/手動実行の認証用シークレット
CRON_SECRET=
# AI生成に必要な Anthropic APIキー（未設定だとスタブ下書きになる）
ANTHROPIC_API_KEY=
